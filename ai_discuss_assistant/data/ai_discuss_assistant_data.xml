<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated AI Assistant Partner for Discuss -->
        <record id="partner_ai_assistant" model="res.partner">
            <field name="name">AI Assistant</field>
            <field name="email">ai.assistant@internal.local</field>
            <field name="active" eval="True"/>
            <field name="comment">AI Assistant Chatbot for Odoo ERP.</field>
        </record>

        <!-- Default Configuration Parameters -->
        <record id="param_ai_discuss_model" model="ir.config_parameter">
            <field name="key">ai_discuss.model</field>
            <field name="value">gpt-4o-mini</field>
        </record>
        <record id="param_ai_discuss_max_history" model="ir.config_parameter">
            <field name="key">ai_discuss.max_history</field>
            <field name="value">8</field>
        </record>
        <record id="param_ai_discuss_enable_tools" model="ir.config_parameter">
            <field name="key">ai_discuss.enable_tools</field>
            <field name="value">True</field>
        </record>
        <record id="param_ai_discuss_enable_sql" model="ir.config_parameter">
            <field name="key">ai_discuss.enable_sql</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>
