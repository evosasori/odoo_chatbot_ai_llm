<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_discuss_context_view_tree" model="ir.ui.view">
        <field name="name">ai.discuss.context.tree</field>
        <field name="model">ai.discuss.context</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="keyword"/>
                <field name="model_name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ai_discuss_context_view_form" model="ir.ui.view">
        <field name="name">ai.discuss.context.form</field>
        <field name="model">ai.discuss.context</field>
        <field name="arch" type="xml">
            <form string="AI Context Keyword">
                <sheet>
                    <group>
                        <group>
                            <field name="keyword"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Deskripsi untuk AI">
                        <field name="description" placeholder="Contoh: Model ini menyimpan data Tabel pasien di SIMRS. Field penting: name = nomor REG (contoh REG5813), tanggal, status, dll. Status: draft/done/cancel. Untuk mengganti status pakai execute_model_method di model cdn.registrasi.periksa."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_discuss_context" model="ir.actions.act_window">
        <field name="name">AI Context Keyword</field>
        <field name="res_model">ai.discuss.context</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_ai_context_top" name="AI Discuss"
              parent="base.menu_administration" sequence="80"/>

    <menuitem id="menu_ai_discuss_context" name="Konfigurasi Konteks AI"
              parent="menu_ai_context_top"
              action="action_ai_discuss_context" sequence="10"/>

</odoo>
